# Copier en .env (jamais commité) et adapter. Toutes les variables sont optionnelles en local.
TENNIS_MLFLOW_TRACKING_URI=http://127.0.0.1:7282
TENNIS_PREFECT_API_URL=http://127.0.0.1:4201/api
TENNIS_MOCK_SOURCE_URL=http://127.0.0.1:8001
TENNIS_API_URL=http://127.0.0.1:8000
TENNIS_POSTGRES_DSN=postgresql://tennis:tennis-local@127.0.0.1:5433/tennis
# URL du workflow Teams (alertes Prefect). Laisser vide pour désactiver. SECRET : jamais dans Git ni dans un message.
TENNIS_TEAMS_WEBHOOK_URL=
# Prénom affiché sur les cartes (canal partagé avec la classe) ; le nom du poste est ajouté par le Makefile.
TENNIS_ALERT_OWNER=
# API de prédiction (phase 7) : son compte PostgreSQL ne peut qu'écrire ses traces et lire les matchs
TENNIS_API_URL=http://127.0.0.1:8000
TENNIS_API_POSTGRES_DSN=postgresql://app_writer:app-writer-local@127.0.0.1:5433/tennis
APP_WRITER_DB_PASSWORD=app-writer-local
GRAFANA_DB_PASSWORD=grafana-reader-local
API_PORT=8000
# Si défini, POST /admin/reload exige l'en-tête X-Admin-Token avec cette valeur
TENNIS_ADMIN_TOKEN=
# Interface web de test (phase 8) : http://127.0.0.1:8501, ne parle qu'à l'API
UI_PORT=8501

# Service d'alertes de la stack (make train, make rollback et make promote le préviennent)
TENNIS_ALERT_SINK_URL=http://127.0.0.1:8090
ALERT_SINK_PORT=8090

# Simulateur de source (mock_source)
MOCK_START_DATE=2015-01-01
# Jours simulés par minute réelle ; 0 = horloge arrêtée (on avance avec `make advance`)
MOCK_SPEED=0
MOCK_SOURCE_PORT=8001

# PostgreSQL de la stack (mots de passe de démonstration, base liée à 127.0.0.1)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres-local
TENNIS_DB_PASSWORD=tennis-local
PREFECT_DB_PASSWORD=prefect-local
PREFECT_PORT=4201

# MLflow de la stack (métadonnées et registre dans PostgreSQL, artefacts dans un volume)
MLFLOW_DB_PASSWORD=mlflow-local
MLFLOW_PORT=7282
