# Copier en .env (jamais commité) et adapter. Toutes les variables sont optionnelles en local.
TENNIS_MLFLOW_TRACKING_URI=http://127.0.0.1:7282
TENNIS_PREFECT_API_URL=http://127.0.0.1:4201/api
TENNIS_MOCK_SOURCE_URL=http://127.0.0.1:8001
TENNIS_API_URL=http://127.0.0.1:8000
TENNIS_POSTGRES_DSN=postgresql://tennis:tennis-local@127.0.0.1:5433/tennis
# URL du workflow Teams (alertes Prefect). Laisser vide pour désactiver.
TENNIS_TEAMS_WEBHOOK_URL=

# Simulateur de source (mock_source)
MOCK_START_DATE=2015-01-01
# Jours simulés par minute réelle ; 0 = horloge arrêtée (on avance avec `make advance`)
MOCK_SPEED=0
MOCK_SOURCE_PORT=8001

# PostgreSQL de la stack (mots de passe de démonstration, base liée à 127.0.0.1)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres-local
TENNIS_DB_PASSWORD=tennis-local
PREFECT_DB_PASSWORD=prefect-local
PREFECT_PORT=4201

# MLflow de la stack (métadonnées et registre dans PostgreSQL, artefacts dans un volume)
MLFLOW_DB_PASSWORD=mlflow-local
MLFLOW_PORT=7282
