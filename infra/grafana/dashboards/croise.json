    {
      "type": "table",
      "title": "Qualité et latence par version",
      "description": "Depuis le début (vue online_metrics) : une ligne par version servie",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT 'v' || model_version AS version, predictions AS prédictions, with_feedback AS jugées, accuracy, log_loss AS \"log loss\", brier, mean_request_ms AS \"latence moyenne\" FROM online_metrics ORDER BY LPAD(model_version, 6, '0')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "latence moyenne"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "barchart",
      "title": "Accuracy et latence par version",
      "description": "Une version plus juste mais plus lente se voit tout de suite",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT 'v' || model_version AS version, accuracy, mean_request_ms AS \"latence (ms)\" FROM online_metrics WHERE with_feedback > 0 ORDER BY LPAD(model_version, 6, '0')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "latence (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "version",
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
    },
    {
