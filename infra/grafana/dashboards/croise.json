      {
        "name": "Incidents",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tennis-pg"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT time, text, tags FROM ( SELECT e.occurred_at AS time, e.title || COALESCE(' — ' || NULLIF(LEFT(e.detail, 300), ''), '') AS text, e.kind AS tags FROM pipeline_events e WHERE e.severity = 'failure' AND e.kind NOT IN ('ingestion_completed', 'alert') ) a WHERE time IS NOT NULL AND $__timeFilter(time) ORDER BY time",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      },
      {
        "name": "Dégradations",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tennis-pg"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT time, text, tags FROM ( SELECT e.occurred_at AS time, e.title || COALESCE(' — ' || NULLIF(LEFT(e.detail, 300), ''), '') AS text, e.kind AS tags FROM pipeline_events e WHERE e.severity = 'warning' AND e.kind NOT IN ('ingestion_completed', 'alert') ) a WHERE time IS NOT NULL AND $__timeFilter(time) ORDER BY time",
          "format": "table",
          "rawQuery": true,
