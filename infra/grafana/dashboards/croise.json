          },
          "rawSql": "SELECT time, text, tags FROM ( SELECT e.occurred_at AS time, e.title || COALESCE(' — ' || NULLIF(LEFT(e.detail, 300), ''), '') AS text, e.kind AS tags FROM pipeline_events e WHERE e.severity = 'info' AND e.kind NOT IN ('ingestion_completed', 'alert') ) a WHERE time IS NOT NULL AND $__timeFilter(time) ORDER BY time",
