    {
      "type": "timeseries",
      "title": "Accuracy et log loss par semaine",
      "description": "Une valeur par semaine de matchs ; les annotations marquent mises en service et incidents",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT date_trunc('week', p.match_date)::timestamp AS time, AVG(CASE WHEN f.winner_id = p.predicted_winner_id THEN 1.0 ELSE 0 END) AS accuracy, AVG(-LN(GREATEST(CASE WHEN f.winner_id = p.p1_id THEN p.p1_win_probability ELSE 1 - p.p1_win_probability END, 1e-15))) AS \"log loss\" FROM predictions p JOIN feedbacks f ON f.match_id = p.match_id WHERE p.client = 'scoring' AND $__timeFilter(p.match_date::timestamp) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
