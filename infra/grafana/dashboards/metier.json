            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT AVG(CASE WHEN f.match_id IS NULL THEN 0.0 ELSE 1 END) AS couverture FROM predictions p LEFT JOIN feedbacks f ON f.match_id = p.match_id WHERE p.client = 'scoring' AND $__timeFilter(p.match_date::timestamp) AND p.match_date <= (SELECT MAX(match_date) FROM matches)",
