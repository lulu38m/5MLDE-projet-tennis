            "uid": "tennis-pg"
          },
          "rawSql": "SELECT time, text, tags FROM ( SELECT COALESCE(e.simulated_date, (SELECT MAX(i.simulated_date) FROM pipeline_events i WHERE i.simulated_date IS NOT NULL AND i.occurred_at <= e.occurred_at))::timestamp AS time, e.title || COALESCE(' — ' || NULLIF(LEFT(e.detail, 300), ''), '') AS text, e.kind AS tags FROM pipeline_events e WHERE e.severity = 'failure' AND e.kind NOT IN ('ingestion_completed', 'alert') ) a WHERE time IS NOT NULL AND $__timeFilter(time) ORDER BY time",
