    {
      "type": "stat",
      "title": "Log loss",
      "description": "Plus bas = meilleur ; 0,693 = pile ou face",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT AVG(-LN(GREATEST(CASE WHEN f.winner_id = p.p1_id THEN p.p1_win_probability ELSE 1 - p.p1_win_probability END, 1e-15))) AS \"log loss\" FROM predictions p JOIN feedbacks f ON f.match_id = p.match_id WHERE p.client = 'scoring' AND $__timeFilter(p.match_date::timestamp)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
