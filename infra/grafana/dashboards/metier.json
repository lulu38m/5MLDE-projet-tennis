    {
      "type": "stat",
      "title": "Accuracy",
      "description": "Le favori du modèle a gagné",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT AVG(CASE WHEN f.winner_id = p.predicted_winner_id THEN 1.0 ELSE 0 END) AS accuracy FROM predictions p JOIN feedbacks f ON f.match_id = p.match_id WHERE p.client = 'scoring' AND $__timeFilter(p.match_date::timestamp)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
