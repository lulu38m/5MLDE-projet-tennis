    {
      "type": "barchart",
      "title": "Calibration du favori",
      "description": "Probabilité annoncée pour le favori et part de victoires réelle, par tranche : un modèle bien calibré a ses deux barres à la même hauteur",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tennis-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tennis-pg"
          },
          "rawSql": "SELECT LPAD((FLOOR(GREATEST(p.p1_win_probability, 1 - p.p1_win_probability) * 10) * 10)::int::text, 2, '0') || '-' || (FLOOR(GREATEST(p.p1_win_probability, 1 - p.p1_win_probability) * 10) * 10 + 10)::int::text || ' %' AS tranche, AVG(GREATEST(p.p1_win_probability, 1 - p.p1_win_probability)) AS annoncée, AVG(CASE WHEN f.winner_id = p.predicted_winner_id THEN 1.0 ELSE 0 END) AS réelle, COUNT(*) AS matchs FROM predictions p JOIN feedbacks f ON f.match_id = p.match_id WHERE p.client = 'scoring' AND $__timeFilter(p.match_date::timestamp) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "matchs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "tranche",
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "id": 11
